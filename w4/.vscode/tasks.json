{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Format c.y (fast)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-File",
        "${workspaceFolder}/tools/format-y.ps1",
        "-Path",
        "${workspaceFolder}/c.y",
        "-TimeoutSeconds",
        "60"
      ],
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
